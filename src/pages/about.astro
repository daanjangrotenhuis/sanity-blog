---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="nl">
<head>
    <BaseHead title={`Over ons — ${SITE_TITLE}`} description="Over Vakantie voor Kids — reistips en inspiratie voor gezinnen." />
</head>
<body>
    <Header />

    <div style="background: var(--warm-dark); padding: 3rem 1.5rem;">
        <div style="max-width: 760px; margin: 0 auto;">
            <h1 style="font-family: 'Playfair Display', serif; font-size: clamp(2rem, 4vw, 2.8rem); font-weight: 700; color: white; margin-bottom: 0.5rem;">
                Over ons
            </h1>
            <p style="font-size: 1rem; color: #B8C8B2; margin: 0;">
                Alles over Vakantie voor Kids
            </p>
        </div>
    </div>

    <main style="max-width: 760px; margin: 0 auto; padding: 3.5rem 1.5rem;">

        <div style="font-size: 1.1rem; line-height: 1.85; color: var(--warm-dark);">
            <p>
                <strong>Vakantie voor Kids</strong> is hét platform voor ouders die op zoek zijn naar de leukste vakanties, dagtrips en uitjes met kinderen. We schrijven eerlijke, praktische artikelen over vakantieparken, bestemmingen en reistips — zodat jij als ouder weet waar je aan toe bent.
            </p>
            <p>
                Of je nu op zoek bent naar een rustig vakantiepark in de Veluwe, een spetterend strand in Zeeland, of een avontuurlijke roadtrip door Europa — wij helpen je op weg.
            </p>

            <div style="background: var(--green-light); border: 1px solid #C5DFD0; border-radius: 12px; padding: 2rem; margin: 2.5rem 0;">
                <h2 style="font-family: 'Playfair Display', serif; font-size: 1.4rem; font-weight: 700; color: var(--warm-dark); margin-bottom: 0.75rem;">
                    Wat vind je op Vakantie voor Kids?
                </h2>
                <ul style="padding-left: 1.25rem; margin: 0; display: flex; flex-direction: column; gap: 0.5rem;">
                    {['Reviews van vakantieparken', 'Reistips voor gezinnen met kinderen', 'De mooiste strandbestemmingen', 'Kamperen met kids', 'Dagtrips en uitjes in Nederland en Europa'].map(item => (
                        <li style="font-size: 1rem; color: var(--warm-dark);">{item}</li>
                    ))}
                </ul>
            </div>

            <p>
                Heb je een vraag of wil je samenwerken? Neem dan contact met ons op via de website.
            </p>
        </div>

        <div style="margin-top: 3rem;">
            <a href="/blog" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.75rem; background: var(--orange); color: white; font-weight: 600; font-size: 0.95rem; border-radius: 8px;" onmouseover="this.style.background='var(--orange-light)'" onmouseout="this.style.background='var(--orange)'">
                Bekijk alle artikelen →
            </a>
        </div>

    </main>

    <Footer />
</body>
</html>

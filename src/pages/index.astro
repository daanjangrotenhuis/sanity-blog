            <a href="/overnachten/weekend-weg-met-kids" class="hero-mobile-nav-link" style="padding-left:1.5rem;font-size:0.82rem;">Weekend weg met kids</a>
            <a href="/overnachten/campings-voor-kids" class="hero-mobile-nav-link" style="padding-left:1.5rem;font-size:0.82rem;">Campings voor kids</a>
            <div style="font-family:'Nunito',sans-serif;font-size:0.7rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:rgba(255,255,255,0.28);padding:0.7rem 0.6rem 0.2rem;">Uitjes</div>

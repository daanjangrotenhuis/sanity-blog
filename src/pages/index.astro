---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { sanityClient } from 'sanity:client';

const posts = await sanityClient.fetch(`
  *[_type == "post"] | order(publishedAt desc) {
    title, slug, publishedAt, body, imageUrl
  }
`);

const featured = posts[0];
const recent = posts.slice(1, 4);
const popular = posts.slice(0, 3);

const totalPosts = posts.length;
const thisYear = new Date().getFullYear();
const postsThisYear = posts.filter((p: any) => p.publishedAt?.startsWith(String(thisYear))).length;
const newestPost = posts[0]?.publishedAt ? new Date(posts[0].publishedAt) : null;
const daysSinceNewest = newestPost ? Math.floor((Date.now() - newestPost.getTime()) / 86400000) : null;

function formatDate(dateStr: string) {
    if (!dateStr) return '';
    return new Date(dateStr).toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' });
}
function excerpt(body: string, length = 130) {
    if (!body) return '';
    const plain = body.replace(/<[^>]+>/g, '');
    return plain.length > length ? plain.slice(0, length).trimEnd() + '…' : plain;
}

const categories = [
    { icon: 'Strand', label: 'Strand & Zee', desc: 'Zonnige bestemmingen' },
    { icon: 'Camping', label: 'Camping', desc: 'Slapen onder de sterren' },
    { icon: 'Park', label: 'Vakantiepark', desc: 'Alles op één plek' },
    { icon: 'Vlieg', label: 'Buitenland', desc: 'Ver van huis' },
    { icon: 'Dag', label: 'Dagtrips', desc: 'Een dag er tussenuit' },
    { icon: 'Natuur', label: 'Natuur', desc: 'Bossen & heide' },
];
---

<!doctype html>
<html lang="nl">
<head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <style>
        html { scroll-behavior: smooth; }

        /* Outlined text */
        .text-outline { -webkit-text-stroke: 2.5px white; color: transparent; }

        /* Nav hover */
        .nav-link { transition: color 0.15s; }
        .nav-link:hover { color: white !important; }

        /* Hero nav dropdowns */
        .hero-drop-wrap {
            position: relative;
        }
        .hero-drop-trigger {
            font-family: 'Nunito', sans-serif;
            font-size: 0.875rem;
            font-weight: 600;
            color: rgba(255,255,255,0.55);
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.25rem;
            transition: color 0.15s;
            cursor: default;
        }
        .hero-drop-trigger:hover { color: white; }
        .hero-drop-trigger svg { width: 9px; height: 9px; transition: transform 0.2s; flex-shrink: 0; }
        .hero-drop-wrap:hover .hero-drop-trigger svg { transform: rotate(180deg); }

        .hero-dropdown {
            position: absolute;
            top: 100%;
            left: 0;
            padding-top: 10px;
            min-width: 210px;
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.18s ease, transform 0.18s ease;
            transform: translateY(-6px);
            z-index: 50;
        }
        .hero-drop-wrap:hover .hero-dropdown {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }
        .hero-dropdown-inner {
            background: rgba(13,40,48,0.96);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 12px;
            padding: 0.5rem;
            box-shadow: 0 16px 40px rgba(0,0,0,0.4);
            backdrop-filter: blur(8px);
        }
        .hero-dropdown-inner a {
            display: block;
            font-family: 'Nunito', sans-serif;
            font-size: 0.84rem;
            font-weight: 600;
            color: rgba(255,255,255,0.65);
            text-decoration: none;
            padding: 0.48rem 0.75rem;
            border-radius: 8px;
            transition: background 0.13s, color 0.13s;
            white-space: nowrap;
        }
        .hero-dropdown-inner a:hover { background: rgba(255,255,255,0.08); color: white; }

        /* Centered nav logo */
        .hero-nav {
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            align-items: center;
            padding: 1.75rem 2.5rem;
            position: relative;
            z-index: 30;
        }
        .hero-nav-left { display: flex; gap: 2rem; }
        .hero-nav-right { display: flex; justify-content: flex-end; align-items: center; gap: 2rem; }

        /* Floating ghost words in hero */
        .hero-ghost {
            position: absolute;
            font-family: 'Fraunces', serif;
            font-weight: 700;
            color: rgba(255,255,255,0.07);
            pointer-events: none;
            white-space: nowrap;
            font-optical-sizing: auto;
            user-select: none;
        }

        /* Trust chips in hero */
        .hero-chip {
            font-family: 'Nunito', sans-serif;
            font-size: 0.78rem;
            font-weight: 700;
            color: rgba(255,255,255,0.85);
            background: rgba(255,255,255,0.12);
            border: 1px solid rgba(255,255,255,0.25);
            padding: 0.4rem 0.9rem;
            border-radius: 30px;
            display: inline-flex;
            align-items: center;
            backdrop-filter: blur(4px);
        }

        /* Category pills — all in the primary turquoise family */
        .cat-pill {
            font-family: 'Nunito', sans-serif;
            font-size: 0.85rem;
            font-weight: 700;
            color: var(--primary-dark);
            background: var(--primary-light);
            border: 1.5px solid #A8E8E2;
            padding: 0.5rem 1.1rem;
            border-radius: 30px;
            text-decoration: none;
            transition: all 0.15s;
            white-space: nowrap;
            display: inline-block;
        }
        .cat-pill:hover {
            background: var(--primary);
            color: white;
            border-color: var(--primary);
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(0,180,166,0.25);
        }

        /* Blog cards */
        .card-accent-teal  { border-top: 3px solid var(--teal); }
        .card-accent-coral { border-top: 3px solid var(--coral); }
        .card-accent-sun   { border-top: 3px solid var(--sun); }

        .cinematic:hover .cinematic-img { transform: scale(1.03); }
        .cinematic-img { transition: transform 0.6s ease; }
        .lift { transition: transform 0.25s ease, box-shadow 0.25s ease; }
        .lift:hover { transform: translateY(-5px); box-shadow: 0 16px 40px rgba(26,31,30,0.12) !important; }

        /* Mobile menu toggle — hidden on desktop */
        .hero-menu-btn {
            display: none;
            background: none;
            border: none;
            color: white;
            width: 36px; height: 36px;
            cursor: pointer;
            font-size: 1.6rem;
            font-weight: 300;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            padding: 0;
            transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .hero-menu-btn.open {
            transform: rotate(180deg);
        }

        /* Mobile nav — absolute from the wrapper div, sits just below the nav bar */
        .hero-mobile-nav {
            position: absolute;
            top: 64px;
            left: 0; right: 0;
            background: rgba(13,40,48,0.02);
            backdrop-filter: blur(10px);
            z-index: 20;
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .hero-mobile-nav.open { max-height: 700px; }
        .hero-mobile-nav-inner {
            padding: 0.75rem 1.25rem 1rem;
            display: flex;
            flex-direction: column;
            gap: 0.15rem;
            border-top: 1px solid rgba(255,255,255,0.08);
        }
        .hero-mobile-nav-link {
            font-family: 'Nunito', sans-serif;
            font-size: 0.88rem;
            font-weight: 600;
            color: rgba(255,255,255,0.65);
            text-decoration: none;
            padding: 0.5rem 0.6rem;
            border-radius: 8px;
            transition: background 0.15s, color 0.15s;
        }
        .hero-mobile-nav-link:hover { background: rgba(255,255,255,0.07); color: white; }
        .hero-mobile-nav-cta {
            margin-top: 0.4rem;
            font-family: 'Nunito', sans-serif;
            font-size: 0.85rem;
            font-weight: 700;
            background: var(--orange);
            color: var(--dark);
            text-decoration: none;
            padding: 0.55rem 1rem;
            border-radius: 30px;
            text-align: center;
            transition: background 0.15s;
            display: block;
        }

        @media (max-width: 768px) {
            .hero-nav {
                display: flex !important;
                justify-content: space-between;
                align-items: center;
                padding: 1.25rem 1.25rem;
            }
            .hero-nav-left { display: none; }
            .hero-nav-right { gap: 0.75rem; }
            .hero-nav-desktop { display: none !important; }
            .hero-menu-btn { display: flex !important; }
            .hero-ghost { display: none; }
            .hero-content { padding: 1.5rem 1.25rem 6rem !important; }
            .feat-content { padding: 1.5rem 1.5rem 1.75rem !important; }
            .grid-3 { grid-template-columns: 1fr !important; }
            .grid-2 { grid-template-columns: 1fr !important; gap: 2.5rem !important; }
            .nl-form { flex-direction: column !important; }
        }
    </style>
</head>
<body style="background: var(--cream);">


---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { sanityClient } from 'sanity:client';

const posts = await sanityClient.fetch(`
  *[_type == "post"] | order(publishedAt desc) {
    title, slug, publishedAt, body, imageUrl
  }
`);

const featured = posts[0];
const rest = posts.slice(1);

function formatDate(dateStr: string) {
    if (!dateStr) return '';
    return new Date(dateStr).toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' });
}

function excerpt(body: string, length = 130) {
    if (!body) return '';
    const plain = body.replace(/<[^>]+>/g, '');
    return plain.length > length ? plain.slice(0, length).trimEnd() + '…' : plain;
}
---

<!doctype html>
<html lang="nl">
<head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
</head>
<body>
    <Header />

    <main style="max-width: 1100px; margin: 0 auto; padding: 4rem 1.5rem;">

        <!-- INTRO -->
        <div style="max-width: 560px; margin-bottom: 4rem;">
            <h1 style="font-family: 'Playfair Display', serif; font-size: clamp(2rem, 4vw, 2.6rem); font-weight: 700; color: var(--dark); line-height: 1.2; margin-bottom: 1rem;">
                Vakanties die kinderen nooit vergeten
            </h1>
            <p style="font-size: 1.05rem; color: var(--muted); line-height: 1.75; margin: 0;">
                Eerlijke verhalen, praktische tips en de mooiste bestemmingen voor gezinnen met kinderen. Geen reclame, gewoon goede reistips.
            </p>
        </div>

        <!-- FEATURED POST -->
        {featured && (
            <section style="margin-bottom: 4.5rem;">
                <p style="font-size: 0.75rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent); margin-bottom: 1.25rem;">
                    Nieuwste artikel
                </p>
                <a href={`/blog/${featured.slug?.current}`} style="display: grid; grid-template-columns: 1fr 1fr; border: 1px solid var(--border); border-radius: 4px; overflow: hidden; background: var(--white); transition: box-shadow 0.2s;" onmouseover="this.style.boxShadow='0 4px 20px rgba(0,0,0,0.07)'" onmouseout="this.style.boxShadow='none'">
                    <div style={`background: #E8E0D8; min-height: 280px; ${featured.imageUrl ? `background-image: url('${featured.imageUrl}'); background-size: cover; background-position: center;` : ''}`}></div>
                    <div style="padding: 2.5rem; display: flex; flex-direction: column; justify-content: center;">
                        <p style="font-size: 0.85rem; color: var(--muted); margin-bottom: 0.75rem;">
                            {formatDate(featured.publishedAt)}
                        </p>
                        <h2 style="font-family: 'Playfair Display', serif; font-size: 1.6rem; font-weight: 700; color: var(--dark); line-height: 1.25; margin-bottom: 1rem;">
                            {featured.title}
                        </h2>
                        <p style="font-size: 0.95rem; color: var(--muted); line-height: 1.65; margin-bottom: 1.5rem;">
                            {excerpt(featured.body, 180)}
                        </p>
                        <span style="font-size: 0.9rem; font-weight: 600; color: var(--accent);">
                            Lees verder →
                        </span>
                    </div>
                </a>
            </section>
        )}

        <!-- RECENT POSTS -->
        {rest.length > 0 && (
            <section>
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem;">
                    <p style="font-size: 0.75rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent); margin: 0;">
                        Meer artikelen
                    </p>
                    <a href="/blog" style="font-size: 0.875rem; color: var(--muted);" onmouseover="this.style.color='var(--dark)'" onmouseout="this.style.color='var(--muted)'">
                        Alles bekijken →
                    </a>
                </div>
                <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem;">
                    {rest.map((post: any) => (
                        <a href={`/blog/${post.slug?.current}`} style="display: block; background: var(--white); border: 1px solid var(--border); border-radius: 4px; overflow: hidden; transition: box-shadow 0.2s;" onmouseover="this.style.boxShadow='0 4px 16px rgba(0,0,0,0.06)'" onmouseout="this.style.boxShadow='none'">
                            <div style={`background: #EDE8E2; height: 140px; ${post.imageUrl ? `background-image: url('${post.imageUrl}'); background-size: cover; background-position: center;` : ''}`}></div>
                            <div style="padding: 1.25rem;">
                                <p style="font-size: 0.78rem; color: var(--muted); margin-bottom: 0.4rem;">
                                    {formatDate(post.publishedAt)}
                                </p>
                                <h3 style="font-family: 'Playfair Display', serif; font-size: 1.05rem; font-weight: 700; color: var(--dark); line-height: 1.3; margin-bottom: 0.5rem;">
                                    {post.title}
                                </h3>
                                <p style="font-size: 0.875rem; color: var(--muted); line-height: 1.6; margin: 0;">
                                    {excerpt(post.body, 100)}
                                </p>
                            </div>
                        </a>
                    ))}
                </div>
            </section>
        )}

        {posts.length === 0 && (
            <p style="color: var(--muted); font-size: 1rem;">Binnenkort verschijnen hier de eerste artikelen.</p>
        )}

    </main>

    <Footer />
</body>
</html>

                    <div class="cinematic-img" style={`position: absolute; inset: 0; background: #2A4A46; ${featured.imageUrl ? `background-image: url('${featured.imageUrl}'); background-size: cover; background-position: center;` : ''}`}></div>
                    <div style="position: absolute; inset: 0; background: linear-gradient(to top, rgba(20,30,28,0.9) 0%, rgba(20,30,28,0.2) 60%, transparent 90%);"></div>
                    <div class="feat-content" style="position: absolute; bottom: 0; left: 0; right: 0; padding: 2.5rem 3rem;">
                        <p style="font-family: 'Nunito', sans-serif; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--yellow); margin-bottom: 0.75rem;">{formatDate(featured.publishedAt)}</p>
                        <h3 style="font-family: 'Fraunces', serif; font-size: clamp(1.5rem, 3vw, 2.4rem); font-weight: 700; color: white; line-height: 1.2; max-width: 680px; font-optical-sizing: auto; margin-bottom: 1rem;">
                            {featured.title}
                        </h3>
                        <span style="font-family: 'Nunito', sans-serif; font-size: 0.875rem; font-weight: 700; color: var(--dark); background: var(--orange); padding: 0.55rem 1.25rem; border-radius: 30px; display: inline-block; box-shadow: 0 4px 12px rgba(232,168,32,0.4);">
                            Lees verder →
                        </span>
                    </div>
                </a>

                {recent.length > 0 && (
                    <div class="grid-3" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem;">
                        {recent.map((post: any, i: number) => (
                            <a href={`/blog/${post.slug?.current}`} class={`lift ${i === 0 ? 'card-accent-teal' : i === 1 ? 'card-accent-coral' : 'card-accent-sun'}`} style="display: block; background: var(--white); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; text-decoration: none; box-shadow: 0 2px 8px rgba(26,31,30,0.05);">
                                <div style={`height: 170px; background: #2A4A46; ${post.imageUrl ? `background-image: url('${post.imageUrl}'); background-size: cover; background-position: center;` : ''}`}></div>
                                <div style="padding: 1.1rem 1.25rem 1.35rem;">
                                    <p style="font-family: 'Nunito', sans-serif; font-size: 0.72rem; color: var(--muted-light); margin-bottom: 0.4rem;">{formatDate(post.publishedAt)}</p>
                                    <h4 style="font-family: 'Fraunces', serif; font-size: 1rem; font-weight: 700; color: var(--dark); line-height: 1.3; font-optical-sizing: auto;">{post.title}</h4>
                                </div>
                            </a>
                        ))}
                    </div>
                )}
            </div>
        </section>
    )}

    <section style="background: var(--mint); padding: 6rem 1.5rem;"><div style="max-width: 1160px; margin: 0 auto;">
        <div class="grid-2" style="display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; align-items: center;">
            <div>
                <p style="font-family: 'Nunito', sans-serif; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--teal); margin-bottom: 0.75rem;">Over ons</p>
                <h2 style="font-family: 'Fraunces', serif; font-size: clamp(1.8rem, 3vw, 2.6rem); font-weight: 700; color: var(--dark); line-height: 1.2; margin-bottom: 1.25rem; font-optical-sizing: auto;">
                    Wij kennen de uitdagingen van reizen met kinderen
                </h2>
                <p style="font-family: 'Nunito', sans-serif; font-size: 1rem; color: var(--muted); line-height: 1.8; margin-bottom: 1rem;">
                    Vakantie voor Kids is opgericht door ouders die weten hoe lastig het is om de perfecte gezinsvakantie te vinden. Geen eindeloos scrollen door recensies — wij zetten de beste vakantieparken, campings en bestemmingen voor je op een rij.
                </p>
                <p style="font-family: 'Nunito', sans-serif; font-size: 1rem; color: var(--muted); line-height: 1.8; margin-bottom: 2rem;">
                    Eerlijk, praktisch, en altijd vanuit het perspectief van een gezin met kinderen.
                </p>
                <a href="/about" style="font-family: 'Nunito', sans-serif; font-size: 0.9rem; font-weight: 700; color: var(--teal); border-bottom: 2px solid var(--teal); padding-bottom: 2px;" onmouseover="this.style.color='var(--teal-dark)';this.style.borderColor='var(--teal-dark)'" onmouseout="this.style.color='var(--teal)';this.style.borderColor='var(--teal)'">
                    Lees meer over ons →
                </a>
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                {[
                    { num: String(totalPosts), label: 'Blogs gepubliceerd' },
                    { num: String(postsThisYear), label: `Blogs in ${thisYear}` },
                    { num: daysSinceNewest === 0 ? 'Vandaag' : daysSinceNewest === 1 ? 'Gisteren' : `${daysSinceNewest}d geleden`, label: 'Laatste publicatie' },
                    { num: '100%', label: 'Eerlijk & onafhankelijk' },
                ].map((stat, i) => (
                    <div style={`background: ${i % 2 === 0 ? 'var(--primary-light)' : 'var(--orange-light)'}; border-radius: 16px; padding: 1.75rem 1.5rem;`}>
                        <div style={`font-family: 'Fraunces', serif; font-size: ${stat.num.length > 6 ? '1.6rem' : '2.4rem'}; font-weight: 700; color: ${i % 2 === 0 ? 'var(--primary-dark)' : 'var(--orange-dark)'}; line-height: 1.1; margin-bottom: 0.4rem; font-optical-sizing: auto;`}>{stat.num}</div>
                        <div style="font-family: 'Nunito', sans-serif; font-size: 0.85rem; color: var(--dark); font-weight: 600;">{stat.label}</div>
                    </div>
                ))}
            </div>
        </div>
    </div></section>

    {popular.length > 0 && (
        <section style="background: var(--sand); padding: 5rem 1.5rem;">
            <div style="max-width: 1160px; margin: 0 auto;">
                <div style="display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 2.5rem; flex-wrap: wrap; gap: 1rem;">
                    <div>
                        <p style="font-family: 'Nunito', sans-serif; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--orange); margin-bottom: 0.6rem;">Meest gelezen</p>
                        <h2 style="font-family: 'Fraunces', serif; font-size: clamp(1.8rem, 3vw, 2.4rem); font-weight: 700; color: var(--dark); font-optical-sizing: auto;">Populaire blogs</h2>
                    </div>
                    <a href="/blog" style="font-family: 'Nunito', sans-serif; font-size: 0.85rem; font-weight: 700; color: var(--teal);" onmouseover="this.style.color='var(--teal-dark)'" onmouseout="this.style.color='var(--teal)'">Alles bekijken →</a>
                </div>
                <div class="grid-3" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem;">
                    {popular.map((post: any, i: number) => (
                        <a href={`/blog/${post.slug?.current}`} class="lift" style="display: block; text-decoration: none; border-radius: 14px; overflow: hidden; position: relative; box-shadow: 0 2px 12px rgba(26,31,30,0.08);">
                            <div style={`height: 260px; background: #2A4A46; ${post.imageUrl ? `background-image: url('${post.imageUrl}'); background-size: cover; background-position: center;` : ''}`}></div>
                            <div style="position: absolute; inset: 0; background: linear-gradient(to top, rgba(20,30,28,0.82) 0%, transparent 55%);"></div>
                            <div style="position: absolute; top: 1rem; left: 1rem;">
                                <span style={`font-family: 'Fraunces', serif; font-size: 1.8rem; font-weight: 700; color: ${i === 0 ? 'var(--yellow)' : i === 1 ? 'var(--orange)' : 'var(--primary)'}; font-optical-sizing: auto; text-shadow: 0 2px 8px rgba(0,0,0,0.3);`}>{String(i + 1).padStart(2, '0')}</span>
                            </div>
                            <div style="position: absolute; bottom: 0; left: 0; right: 0; padding: 1.25rem 1.4rem;">
                                <p style="font-family: 'Nunito', sans-serif; font-size: 0.7rem; color: rgba(255,255,255,0.55); margin-bottom: 0.35rem;">{formatDate(post.publishedAt)}</p>
                                <h4 style="font-family: 'Fraunces', serif; font-size: 1.05rem; font-weight: 700; color: white; line-height: 1.3; font-optical-sizing: auto;">{post.title}</h4>
                            </div>
                        </a>
                    ))}
                </div>
            </div>
        </section>
    )}

    <section style="padding: 5rem 1.5rem; background: var(--sun-light);">
        <div style="max-width: 560px; margin: 0 auto; text-align: center;">
            <p style="font-family: 'Nunito', sans-serif; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--orange-dark); margin-bottom: 0.75rem;">Blijf op de hoogte</p>
            <h2 style="font-family: 'Fraunces', serif; font-size: clamp(1.8rem, 3vw, 2.2rem); font-weight: 700; color: var(--dark); margin-bottom: 1rem; font-optical-sizing: auto;">
                Geen vakantietip missen?
            </h2>
            <p style="font-family: 'Nunito', sans-serif; font-size: 1rem; color: var(--muted); line-height: 1.75; margin-bottom: 2rem;">
                Schrijf je in en ontvang de beste reistips, vakantieparken en aanbiedingen rechtstreeks in je inbox.
            </p>
            <form class="nl-form" style="display: flex; gap: 0.75rem; max-width: 420px; margin: 0 auto;" onsubmit="return false;">
                <input type="email" placeholder="jouw@email.nl" style="flex: 1; font-family: 'Nunito', sans-serif; font-size: 0.9rem; padding: 0.8rem 1.1rem; border: 2px solid #F5DFA0; border-radius: 30px; background: white; color: var(--dark); outline: none;" />
                <button type="submit" style="font-family: 'Nunito', sans-serif; font-size: 0.875rem; font-weight: 700; background: var(--orange); color: var(--dark); padding: 0.8rem 1.4rem; border-radius: 30px; border: none; cursor: pointer; white-space: nowrap; transition: background 0.15s; box-shadow: 0 4px 12px rgba(232,168,32,0.3);" onmouseover="this.style.background='var(--orange-dark)'" onmouseout="this.style.background='var(--orange)'">
                    Inschrijven
                </button>
            </form>
            <p style="font-family: 'Nunito', sans-serif; font-size: 0.75rem; color: var(--muted-light); margin-top: 0.75rem;">Geen spam. Uitschrijven kan altijd.</p>
        </div>
    </section>

    <Footer />

    <script>
        const btn  = document.getElementById('heroMenuToggle');
        const nav  = document.getElementById('heroMobileNav');
        const icon = document.getElementById('heroMenuIcon');
        btn?.addEventListener('click', () => {
            const open = nav?.classList.toggle('open');
            btn.classList.toggle('open', open);
            if (icon) icon.textContent = open ? '−' : '+';
        });
    </script>
</body>
</html>

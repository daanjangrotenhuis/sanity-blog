---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';
import { sanityClient } from 'sanity:client';

const { slug } = Astro.params;

const post = await sanityClient.fetch(`
    *[_type == "post" && slug.current == $slug][0] {
        title, slug, publishedAt, body, imageUrl
    }
`, { slug });

if (!post) return Astro.redirect('/');

const related = await sanityClient.fetch(`
    *[_type == "post" && slug.current != $slug] | order(publishedAt desc)[0...3] {
        title, slug, publishedAt, body, imageUrl
    }
`, { slug });

function formatDate(dateStr: string) {
    if (!dateStr) return '';
    return new Date(dateStr).toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' });
}

function excerpt(body: string, length = 100) {
    if (!body) return '';
    const plain = body.replace(/<[^>]+>/g, '');
    return plain.length > length ? plain.slice(0, length).trimEnd() + '…' : plain;
}

function readingTime(body: string) {
    if (!body) return '1';
    const plain = body.replace(/<[^>]+>/g, '');
    return Math.max(1, Math.ceil(plain.split(/\s+/).length / 200)).toString();
}

const articleSchema = {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": post.title,
    "description": excerpt(post.body, 160),
    "datePublished": post.publishedAt,
    "dateModified": post.publishedAt,
    "image": post.imageUrl ?? null,
    "url": `https://www.vakantievoorkids.nl/blog/${post.slug.current}`,
    "inLanguage": "nl-NL",
    "publisher": {
        "@type": "Organization",
        "name": "Vakantie voor Kids",
        "url": "https://www.vakantievoorkids.nl"
    }
};
---

<!doctype html>
<html lang="nl">
<head>
    <BaseHead title={`${post.title} — ${SITE_TITLE}`} description={excerpt(post.body, 160)} schema={articleSchema} />
</head>
<body>
    <Header />

    <main style="max-width: 720px; margin: 0 auto; padding: 3.5rem 1.5rem;">

        <a href="/" style="font-size: 0.875rem; color: var(--muted); display: inline-block; margin-bottom: 2.5rem;" onmouseover="this.style.color='var(--dark)'" onmouseout="this.style.color='var(--muted)'">
            ← Terug
        </a>

        <article>
            <div style="margin-bottom: 2rem;">
                <p style="font-size: 0.8rem; color: var(--muted); margin-bottom: 0.75rem;">
                    {formatDate(post.publishedAt)} &middot; {readingTime(post.body)} min leestijd
                </p>
                <h1 style="font-family: 'Playfair Display', serif; font-size: clamp(1.9rem, 4.5vw, 2.75rem); font-weight: 700; line-height: 1.2; color: var(--dark);">
                    {post.title}
                </h1>
            </div>

            <hr style="border: none; border-top: 1px solid var(--border); margin: 2rem 0 2.5rem;" />

            {post.imageUrl && (
                <img src={post.imageUrl} alt={post.title} style="width: 100%; height: 420px; object-fit: cover; border-radius: 4px; margin-bottom: 2.5rem;" />
            )}

            <div class="post-body" style="font-size: 1.05rem;" set:html={post.body} />
        </article>

        <hr style="border: none; border-top: 1px solid var(--border); margin: 3.5rem 0 2rem;" />

        <a href="/" style="font-size: 0.875rem; color: var(--muted);" onmouseover="this.style.color='var(--dark)'" onmouseout="this.style.color='var(--muted)'">
            ← Meer artikelen
        </a>

    </main>

    {related.length > 0 && (
        <section style="border-top: 1px solid var(--border); padding: 3.5rem 1.5rem;">
            <div style="max-width: 1100px; margin: 0 auto;">
                <p style="font-size: 0.75rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent); margin-bottom: 1.5rem;">
                    Meer lezen
                </p>
                <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem;">
                    {related.map((p: any) => (
                        <a href={`/blog/${p.slug?.current}`} style="display: block; background: var(--white); border: 1px solid var(--border); border-radius: 4px; overflow: hidden; transition: box-shadow 0.2s;" onmouseover="this.style.boxShadow='0 4px 16px rgba(0,0,0,0.06)'" onmouseout="this.style.boxShadow='none'">
                                            <div style={`background: #EDE8E2; height: 120px; ${p.imageUrl ? `background-image: url('${p.imageUrl}'); background-size: cover; background-position: center;` : ''}`}></div>
                            <div style="padding: 1.1rem 1.25rem 1.25rem;">
                                <p style="font-size: 0.75rem; color: var(--muted); margin-bottom: 0.4rem;">{formatDate(p.publishedAt)}</p>
                                <h4 style="font-family: 'Playfair Display', serif; font-size: 1rem; font-weight: 700; color: var(--dark); line-height: 1.3; margin: 0;">
                                    {p.title}
                                </h4>
                            </div>
                        </a>
                    ))}
                </div>
            </div>
        </section>
    )}

    <Footer />
</body>
</html>

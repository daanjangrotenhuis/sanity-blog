---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';
import { sanityClient } from 'sanity:client';

const { slug } = Astro.params;

const post = await sanityClient.fetch(`
    *[_type == "post" && slug.current == $slug][0] {
        title, slug, publishedAt, body, imageUrl
    }
`, { slug });

if (!post) return Astro.redirect('/');

const related = await sanityClient.fetch(`
    *[_type == "post" && slug.current != $slug] | order(publishedAt desc)[0...3] {
        title, slug, publishedAt, body, imageUrl
    }
`, { slug });

function formatDate(dateStr: string) {
    if (!dateStr) return '';
    return new Date(dateStr).toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' });
}

function excerpt(body: string, length = 100) {
    if (!body) return '';
    const plain = body.replace(/<[^>]+>/g, '');
    return plain.length > length ? plain.slice(0, length).trimEnd() + '…' : plain;
}

function readingTime(body: string) {
    if (!body) return '1';
    const plain = body.replace(/<[^>]+>/g, '');
    return Math.max(1, Math.ceil(plain.split(/\s+/).length / 200)).toString();
}

const articleSchema = {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": post.title,
    "description": excerpt(post.body, 160),
    "datePublished": post.publishedAt,
    "dateModified": post.publishedAt,
    "image": post.imageUrl ?? null,
    "url": `https://www.vakantievoorkids.nl/blog/${post.slug.current}`,
    "inLanguage": "nl-NL",
    "publisher": {
        "@type": "Organization",
        "name": "Vakantie voor Kids",
        "url": "https://www.vakantievoorkids.nl"
    }
};

const breadcrumbSchema = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.vakantievoorkids.nl" },
        { "@type": "ListItem", "position": 2, "name": "Blogs", "item": "https://www.vakantievoorkids.nl/blog" },
        { "@type": "ListItem", "position": 3, "name": post.title, "item": `https://www.vakantievoorkids.nl/blog/${post.slug.current}` }
    ]
};
---

<!doctype html>
<html lang="nl">
<head>
    <BaseHead title={`${post.title} — ${SITE_TITLE}`} description={excerpt(post.body, 160)} schema={[articleSchema, breadcrumbSchema]} />
</head>
<style>
    @media (max-width: 768px) {
        .related-grid { grid-template-columns: 1fr !important; }
    }
</style>
<body>
    <Header />

    {post.imageUrl && (
        <div style={`width: 100%; height: 480px; background: #C8DFDB; background-image: url('${post.imageUrl}'); background-size: cover; background-position: center;`}></div>
    )}

    <main style="max-width: 740px; margin: 0 auto; padding: 3rem 1.5rem;">

        <nav aria-label="Breadcrumb" style="display: flex; align-items: center; gap: 0.4rem; font-size: 0.8rem; color: var(--muted-light); margin-bottom: 2rem; flex-wrap: wrap;">
            <a href="/" style="color: var(--muted-light); transition: color 0.15s;" onmouseover="this.style.color='var(--dark)'" onmouseout="this.style.color='var(--muted-light)'">Home</a>
            <span>/</span>
            <a href="/blog" style="color: var(--muted-light); transition: color 0.15s;" onmouseover="this.style.color='var(--dark)'" onmouseout="this.style.color='var(--muted-light)'">Blogs</a>
            <span>/</span>
            <span style="color: var(--dark); font-weight: 500;">{post.title}</span>
        </nav>

        <article>
            <div style="margin-bottom: 1.75rem;">
                <p style="font-size: 0.8rem; color: var(--muted-light); margin-bottom: 1rem;">
                    {formatDate(post.publishedAt)} &middot; {readingTime(post.body)} min leestijd
                </p>
                <h1 style="font-family: 'Fraunces', serif; font-size: clamp(1.9rem, 4.5vw, 2.75rem); font-weight: 700; line-height: 1.2; color: var(--dark); font-optical-sizing: auto;">
                    {post.title}
                </h1>
            </div>

            <hr style="border: none; border-top: 1px solid var(--border); margin: 2rem 0 2.5rem;" />

            <div class="post-body" set:html={post.body} />
        </article>

        <hr style="border: none; border-top: 1px solid var(--border); margin: 3.5rem 0 2rem;" />

        <a href="/blog" style="font-family: 'Nunito', sans-serif; font-size: 0.875rem; color: var(--primary); font-weight: 700;" onmouseover="this.style.color='var(--primary-dark)'" onmouseout="this.style.color='var(--primary)'">
            ← Meer blogs lezen
        </a>

    </main>

    {related.length > 0 && (
        <section style="background: var(--primary-light); border-top: 1px solid var(--border); padding: 4rem 1.5rem; margin-top: 3rem;">
            <div style="max-width: 1140px; margin: 0 auto;">
                <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 2rem;">
                    <span style="font-family: 'Nunito', sans-serif; font-size: 0.68rem; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; color: var(--primary-dark);">Meer lezen</span>
                    <div style="flex: 1; height: 1px; background: var(--border);"></div>
                </div>
                <div class="related-grid" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem;">
                    {related.map((p: any, i: number) => (
                        <a href={`/blog/${p.slug?.current}`} style={`display: block; background: var(--white); border: 1.5px solid var(--border); border-top: 3px solid ${i === 0 ? 'var(--primary)' : i === 1 ? 'var(--orange)' : 'var(--yellow)'}; border-radius: 12px; overflow: hidden; text-decoration: none; transition: transform 0.2s, box-shadow 0.2s;`} onmouseover="this.style.transform='translateY(-4px)';this.style.boxShadow='0 12px 32px rgba(13,40,48,0.1)'" onmouseout="this.style.transform='';this.style.boxShadow=''">
                            <div style={`height: 140px; background: var(--primary-light); ${p.imageUrl ? `background-image: url('${p.imageUrl}'); background-size: cover; background-position: center;` : ''}`}></div>
                            <div style="padding: 1.1rem 1.25rem 1.35rem;">
                                <p style="font-family: 'Nunito', sans-serif; font-size: 0.75rem; color: var(--muted-light); margin-bottom: 0.35rem;">{formatDate(p.publishedAt)}</p>
                                <h4 style="font-family: 'Fraunces', serif; font-size: 1rem; font-weight: 700; color: var(--dark); line-height: 1.3; margin: 0; font-optical-sizing: auto;">{p.title}</h4>
                            </div>
                        </a>
                    ))}
                </div>
            </div>
        </section>
    )}

    <Footer />
</body>
</html>

---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';
import { sanityClient } from 'sanity:client';

const posts = await sanityClient.fetch(`
    *[_type == "post"] | order(publishedAt desc) {
        title, slug, publishedAt, body
    }
`);

function formatDate(dateStr: string) {
    if (!dateStr) return '';
    return new Date(dateStr).toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' });
}

function excerpt(body: string, length = 120) {
    if (!body) return '';
    const plain = body.replace(/<[^>]+>/g, '');
    return plain.length > length ? plain.slice(0, length).trimEnd() + '…' : plain;
}
---

<!doctype html>
<html lang="nl">
<head>
    <BaseHead title={`Artikelen — ${SITE_TITLE}`} description="Alle reisverhalen en tips voor vakanties met kinderen." />
</head>
<body>
    <Header />

    <main style="max-width: 1100px; margin: 0 auto; padding: 4rem 1.5rem;">

        <div style="margin-bottom: 3rem;">
            <h1 style="font-family: 'Playfair Display', serif; font-size: clamp(1.8rem, 3.5vw, 2.4rem); font-weight: 700; color: var(--dark); margin-bottom: 0.5rem;">
                Alle artikelen
            </h1>
            <p style="font-size: 0.95rem; color: var(--muted); margin: 0;">
                {posts.length} artikel{posts.length !== 1 ? 'en' : ''}
            </p>
        </div>

        {posts.length > 0 ? (
            <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem;">
                {posts.map((post: any) => (
                    <a href={`/blog/${post.slug?.current}`} style="display: block; background: var(--white); border: 1px solid var(--border); border-radius: 4px; overflow: hidden; transition: box-shadow 0.2s;" onmouseover="this.style.boxShadow='0 4px 16px rgba(0,0,0,0.06)'" onmouseout="this.style.boxShadow='none'">
                        <div style="background: #EDE8E2; height: 150px;"></div>
                        <div style="padding: 1.25rem;">
                            <p style="font-size: 0.78rem; color: var(--muted); margin-bottom: 0.4rem;">
                                {formatDate(post.publishedAt)}
                            </p>
                            <h2 style="font-family: 'Playfair Display', serif; font-size: 1.05rem; font-weight: 700; color: var(--dark); line-height: 1.3; margin-bottom: 0.5rem;">
                                {post.title}
                            </h2>
                            <p style="font-size: 0.875rem; color: var(--muted); line-height: 1.6; margin: 0;">
                                {excerpt(post.body)}
                            </p>
                        </div>
                    </a>
                ))}
            </div>
        ) : (
            <p style="color: var(--muted);">Binnenkort verschijnen hier de eerste artikelen.</p>
        )}

    </main>

    <Footer />
</body>
</html>

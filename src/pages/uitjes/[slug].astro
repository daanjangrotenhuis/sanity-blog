---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PillarPageLayout from '../../components/PillarPageLayout.astro';
import { SITE_TITLE } from '../../consts';
import { findSubcategory } from '../../data/categories';
import { sanityClient } from 'sanity:client';

const { slug } = Astro.params;
const category = findSubcategory('uitjes', slug!);
if (!category) return Astro.redirect('/uitjes');

const [pillar, posts] = await Promise.all([
    sanityClient.fetch(`*[_type == "pillarPage" && slug.current == $slug][0]{ title, label, intro, content, metaDescription }`, { slug }),
    sanityClient.fetch(`*[_type == "post" && $cat in categories] | order(publishedAt desc) { title, slug, publishedAt, body, imageUrl }`, { cat: category.sanityValue }),
]);

const title = pillar?.title ?? category.title;
const label = pillar?.label ?? 'Uitjes';
const intro = pillar?.intro ?? category.intro;
const metaDescription = pillar?.metaDescription ?? intro;
---

<!doctype html>
<html lang="nl">
<head>
    <BaseHead title={`${title} — ${SITE_TITLE}`} description={metaDescription} />
</head>
<body style="background: var(--cream);">
    <Header />
    <PillarPageLayout
        title={title}
        label={label}
        intro={intro}
        pillarContent={pillar?.content}
        posts={posts}
        breadcrumb={{ label: 'Uitjes', href: '/uitjes' }}
    />
    <Footer />
</body>
</html>

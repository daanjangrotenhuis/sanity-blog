---
const currentPath = Astro.url.pathname;
---

<style>
    .header-nav-link {
        font-family: 'Nunito', sans-serif;
        font-size: 0.875rem;
        font-weight: 600;
        padding: 0.4rem 0.9rem;
        border-radius: 20px;
        transition: all 0.15s;
        text-decoration: none;
        color: rgba(255,255,255,0.6);
    }
    .header-nav-link:hover { color: white; }
    .header-nav-link.active { background: var(--primary); color: white; }

    .menu-toggle {
        display: none;
        background: none;
        border: none;
        color: white;
        width: 38px; height: 38px;
        cursor: pointer;
        font-size: 1.6rem;
        font-weight: 300;
        align-items: center;
        justify-content: center;
        padding: 0;
        transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        flex-shrink: 0;
    }
    .menu-toggle.open { transform: rotate(180deg); }

    .mobile-nav {
        display: none;
        overflow: hidden;
        max-height: 0;
        transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        border-top: 1px solid rgba(255,255,255,0.07);
    }
    .mobile-nav.open { max-height: 200px; }
    .mobile-nav-inner {
        padding: 0.6rem 1.25rem 0.9rem;
        display: flex;
        flex-direction: column;
        gap: 0.1rem;
    }
    .mobile-nav-link {
        font-family: 'Nunito', sans-serif;
        font-size: 0.88rem;
        font-weight: 600;
        color: rgba(255,255,255,0.6);
        text-decoration: none;
        padding: 0.45rem 0.6rem;
        border-radius: 8px;
        transition: background 0.15s, color 0.15s;
    }
    .mobile-nav-link:hover { background: rgba(255,255,255,0.07); color: white; }
    .mobile-nav-link.active { color: var(--primary); }

    @media (max-width: 640px) {
        .header-desktop-nav { display: none !important; }
        .menu-toggle { display: flex !important; }
        .mobile-nav { display: block !important; }
        .header-inner { padding: 0 1.25rem !important; }
        .header-logo span { font-size: 1rem !important; }
    }
</style>

<header style="background: var(--dark);">
    <div class="header-inner" style="max-width: 1160px; margin: 0 auto; padding: 0 2rem; display: flex; align-items: center; justify-content: space-between; height: 66px;">

        <a href="/" class="header-logo" style="text-decoration: none; display: flex; align-items: baseline; gap: 0; flex-shrink: 0;">
            <span style="font-family: 'Fraunces', serif; font-size: 1.2rem; font-weight: 700; color: white; font-optical-sizing: auto;">Vakantie</span>
            <span style="font-family: 'Fraunces', serif; font-size: 1.2rem; font-weight: 300; font-style: italic; color: var(--yellow); font-optical-sizing: auto;">&nbsp;voor Kids</span>
        </a>

        <nav class="header-desktop-nav" style="display: flex; align-items: center; gap: 0.5rem;">
            {[['/', 'Home'], ['/blog', 'Blogs'], ['/about', 'Over ons']].map(([href, label]) => (
                <a href={href} class={`header-nav-link${currentPath === href ? ' active' : ''}`}>{label}</a>
            ))}
            <a href="/blog" style="font-family: 'Nunito', sans-serif; font-size: 0.82rem; font-weight: 700; background: var(--orange); color: var(--dark); padding: 0.45rem 1.1rem; border-radius: 30px; text-decoration: none; margin-left: 0.5rem; transition: background 0.15s;" onmouseover="this.style.background='var(--orange-dark)'" onmouseout="this.style.background='var(--orange)'">
                Alle blogs
            </a>
        </nav>

        <button class="menu-toggle" id="menuToggle" aria-label="Menu openen">
            <i id="menuIcon" style="font-style:normal;">+</i>
        </button>
    </div>

    <div class="mobile-nav" id="mobileNav">
        <div class="mobile-nav-inner">
            {[['/', 'Home'], ['/blog', 'Blogs'], ['/about', 'Over ons']].map(([href, label]) => (
                <a href={href} class={`mobile-nav-link${currentPath === href ? ' active' : ''}`}>{label}</a>
            ))}
        </div>
    </div>
</header>

<script>
    const toggle = document.getElementById('menuToggle');
    const nav    = document.getElementById('mobileNav');
    const icon   = document.getElementById('menuIcon');

    toggle?.addEventListener('click', () => {
        const isOpen = nav?.classList.toggle('open');
        toggle.classList.toggle('open', isOpen);
        if (icon) icon.textContent = isOpen ? '−' : '+';
        toggle.setAttribute('aria-label', isOpen ? 'Menu sluiten' : 'Menu openen');
    });
</script>

---
const currentPath = Astro.url.pathname;
---

<header style="background: var(--cream); border-bottom: 1px solid var(--border); position: sticky; top: 0; z-index: 100; backdrop-filter: blur(8px);">
    <div style="max-width: 1160px; margin: 0 auto; padding: 0 1.5rem; display: flex; align-items: center; justify-content: space-between; height: 68px;">

        <a href="/" style="text-decoration: none; display: flex; align-items: baseline; gap: 0.15rem;">
            <span style="font-family: 'Fraunces', serif; font-size: 1.3rem; font-weight: 700; color: var(--dark); font-optical-sizing: auto;">Vakantie</span>
            <span style="font-family: 'Fraunces', serif; font-size: 1.3rem; font-weight: 300; font-style: italic; color: var(--teal); font-optical-sizing: auto;">&nbsp;voor Kids</span>
        </a>

        <nav style="display: flex; align-items: center; gap: 0.25rem;">
            {[['/', 'Home'], ['/blog', 'Blogs'], ['/about', 'Over ons']].map(([href, label]) => (
                <a
                    href={href}
                    style={`font-family: 'Nunito', sans-serif; font-size: 0.875rem; font-weight: 600; padding: 0.4rem 0.85rem; border-radius: 20px; transition: all 0.15s; ${currentPath === href ? 'background: var(--teal); color: white;' : 'color: var(--muted);'}`}
                    onmouseover={`if(this.style.background !== 'var(--teal)') { this.style.background='var(--teal-light)'; this.style.color='var(--teal)'; }`}
                    onmouseout={`if(this.style.color !== 'white') { this.style.background='transparent'; this.style.color='var(--muted)'; }`}
                >
                    {label}
                </a>
            ))}
        </nav>

    </div>
</header>

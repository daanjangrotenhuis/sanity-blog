---
interface Props {
    title: string;
    label: string;
    intro: string;
    heroImageUrl?: string;
    pillarContent?: string;
    subcategories?: { slug: string; title: string; description: string; href: string }[];
    posts: any[];
    breadcrumb?: { label: string; href: string };
}

const { title, label, intro, heroImageUrl, pillarContent, subcategories, posts, breadcrumb } = Astro.props;

function formatDate(dateStr: string) {
    if (!dateStr) return '';
    return new Date(dateStr).toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' });
}

function excerpt(body: string, length = 115) {
    if (!body) return '';
    const plain = body.replace(/<[^>]+>/g, '');
    return plain.length > length ? plain.slice(0, length).trimEnd() + '…' : plain;
}
---

<style>
    /* Hero */
    .pillar-hero {
        position: relative;
        min-height: 480px;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        overflow: hidden;
        background: var(--dark);
    }
    .pillar-hero-img {
        position: absolute;
        inset: 0;
        background-size: cover;
        background-position: center;
        transition: transform 0.6s ease;
    }
    .pillar-hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(170deg, rgba(13,40,48,0.45) 0%, rgba(13,40,48,0.75) 100%);
    }
    .pillar-hero-content {
        position: relative;
        z-index: 2;
        max-width: 1160px;
        margin: 0 auto;
        padding: 3rem 2rem 4rem;
        width: 100%;
    }
    .pillar-hero-wave {
        position: absolute;
        bottom: -2px;
        left: 0;
        right: 0;
        z-index: 3;
        line-height: 0;
    }

    /* Article prose — all global so set:html content is styled */
    :global(.pillar-body) { max-width: 760px; margin: 0 auto; }

    :global(.pillar-body h2) {
        font-family: 'Fraunces', serif;
        font-size: clamp(1.65rem, 3vw, 2.1rem);
        font-weight: 700;
        color: var(--dark);
        margin: 3.5rem 0 1rem;
        line-height: 1.2;
        font-optical-sizing: auto;
        padding-bottom: 0.75rem;
        border-bottom: 2px solid var(--border);
    }
    :global(.pillar-body h2:first-child) { margin-top: 0; }

    :global(.pillar-body h3) {
        font-family: 'Fraunces', serif;
        font-size: 1.3rem;
        font-weight: 700;
        color: var(--dark);
        margin: 2.5rem 0 0.65rem;
        font-optical-sizing: auto;
        padding-left: 0.9rem;
        border-left: 3px solid var(--primary);
    }
    :global(.pillar-body h4) {
        font-family: 'Nunito', sans-serif;
        font-weight: 700;
        color: var(--primary-dark);
        margin: 1.75rem 0 0.5rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        font-size: 0.82rem;
    }
    :global(.pillar-body p) {
        font-family: 'Nunito', sans-serif;
        font-size: 1.025rem;
        color: var(--muted);
        line-height: 1.9;
        margin: 0 0 1.25rem;
    }
    :global(.pillar-body strong) { color: var(--dark); font-weight: 700; }
    :global(.pillar-body blockquote) {
        border-left: 4px solid var(--primary);
        margin: 2rem 0;
        padding: 1rem 1.5rem;
        background: var(--primary-light);
        border-radius: 0 12px 12px 0;
        font-family: 'Fraunces', serif;
        font-size: 1.1rem;
        font-style: italic;
        color: var(--dark);
        line-height: 1.7;
        font-optical-sizing: auto;
    }
    :global(.pillar-body a) { color: var(--primary-dark); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
    :global(.pillar-body a:hover) { color: var(--primary); }

    /* Cards */
    .sub-card { transition: transform 0.22s ease, box-shadow 0.22s ease; }
    .sub-card:hover { transform: translateY(-5px); box-shadow: 0 16px 40px rgba(13,40,48,0.12) !important; }
    .post-card { transition: transform 0.22s ease, box-shadow 0.22s ease; }
    .post-card:hover { transform: translateY(-5px); box-shadow: 0 16px 40px rgba(13,40,48,0.12) !important; }

    /* Responsive */
    @media (max-width: 768px) {
        .pillar-hero { min-height: 340px; }
        .pillar-hero-content { padding: 2rem 1.25rem 3rem; }
        .posts-grid { grid-template-columns: 1fr !important; }
        .sub-grid  { grid-template-columns: 1fr !important; }
        .pillar-content-grid { grid-template-columns: 1fr !important; }
        .pillar-aside { display: none !important; }
    }
    @media (min-width: 769px) and (max-width: 1024px) {
        .posts-grid { grid-template-columns: repeat(2, 1fr) !important; }
        .sub-grid  { grid-template-columns: repeat(2, 1fr) !important; }
        .pillar-content-grid { grid-template-columns: 1fr 240px !important; gap: 2.5rem !important; }
    }
</style>

<!-- HERO -->
<div class="pillar-hero">
    <div class="pillar-hero-img" style={heroImageUrl ? `background-image: url('${heroImageUrl}');` : 'background: var(--dark);'}></div>
    <div class="pillar-hero-overlay"></div>

    <div class="pillar-hero-content">
        {breadcrumb && (
            <p style="font-family:'Nunito',sans-serif; font-size:0.78rem; color:rgba(255,255,255,0.4); margin-bottom:0.75rem;">
                <a href={breadcrumb.href} style="color:rgba(255,255,255,0.4); text-decoration:none;">{breadcrumb.label}</a>
                {' / '}<span style="color:rgba(255,255,255,0.6);">{title}</span>
            </p>
        )}
        <p style="font-family:'Nunito',sans-serif; font-size:0.68rem; font-weight:700; letter-spacing:0.18em; text-transform:uppercase; color:var(--yellow); margin-bottom:0.75rem;">{label}</p>
        <h1 style="font-family:'Fraunces',serif; font-size:clamp(2.2rem,5vw,3.4rem); font-weight:700; color:white; line-height:1.1; margin-bottom:1.1rem; font-optical-sizing:auto; max-width:720px;">{title}</h1>
        <p style="font-family:'Nunito',sans-serif; font-size:1.05rem; color:rgba(255,255,255,0.65); max-width:580px; line-height:1.75; margin:0 0 1.75rem;">{intro}</p>
        {posts.length > 0 && (
            <a href="#blogs" style="font-family:'Nunito',sans-serif; font-size:0.875rem; font-weight:700; background:var(--orange); color:var(--dark); padding:0.7rem 1.5rem; border-radius:30px; text-decoration:none; display:inline-block; box-shadow:0 4px 16px rgba(232,168,32,0.35);">
                Bekijk {posts.length} blog{posts.length !== 1 ? 's' : ''} →
            </a>
        )}
    </div>

    <div class="pillar-hero-wave">
        <svg viewBox="0 0 1440 70" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none" style="display:block; width:100%; height:70px;">
            <path d="M0,0 C360,65 720,5 1080,50 C1260,65 1380,15 1440,0 L1440,70 L0,70 Z" fill="#F7FDFC"/>
        </svg>
    </div>
</div>

<!-- PILLAR CONTENT -->
{pillarContent && (
    <section style="background: var(--white); border-top: 4px solid var(--primary); border-bottom: 1px solid var(--border);">
        <div class="pillar-content-grid" style="max-width: 1160px; margin: 0 auto; padding: 4.5rem 1.5rem 5rem; display: grid; grid-template-columns: 1fr 300px; gap: 4rem; align-items: start;">
            <article class="pillar-body" set:html={pillarContent} />
            <aside class="pillar-aside" style="position: sticky; top: 2rem;">
                <div style="background: var(--cream); border: 1.5px solid var(--border); border-top: 3px solid var(--orange); border-radius: 14px; padding: 1.5rem;">
                    <p style="font-family:'Nunito',sans-serif; font-size:0.68rem; font-weight:700; letter-spacing:0.14em; text-transform:uppercase; color:var(--orange-dark); margin-bottom:1rem;">In dit artikel</p>
                    <nav style="display:flex; flex-direction:column; gap:0.1rem;" id="pillar-toc"></nav>
                </div>
                {subcategories && subcategories.length > 0 && (
                    <div style="margin-top:1.25rem; background:var(--primary-light); border:1.5px solid #A8E8E2; border-radius:14px; padding:1.5rem;">
                        <p style="font-family:'Nunito',sans-serif; font-size:0.68rem; font-weight:700; letter-spacing:0.14em; text-transform:uppercase; color:var(--primary-dark); margin-bottom:1rem;">Categorieën</p>
                        <div style="display:flex; flex-direction:column; gap:0.35rem;">
                            {subcategories.map(sub => (
                                <a href={sub.href} style="font-family:'Nunito',sans-serif; font-size:0.875rem; font-weight:600; color:var(--primary-dark); text-decoration:none; padding:0.4rem 0.6rem; border-radius:8px; transition:background 0.15s;" onmouseover="this.style.background='rgba(0,180,166,0.12)'" onmouseout="this.style.background=''">{sub.title} →</a>
                            ))}
                        </div>
                    </div>
                )}
            </aside>
        </div>
    </section>
)}

<!-- SUBCATEGORY CARDS -->
{subcategories && subcategories.length > 0 && (
    <section style="background:var(--white); border-top:1px solid var(--border); border-bottom:1px solid var(--border); padding:4rem 1.5rem;">
        <div style="max-width:1160px; margin:0 auto;">
            <div style="margin-bottom:2rem;">
                <p style="font-family:'Nunito',sans-serif; font-size:0.68rem; font-weight:700; letter-spacing:0.18em; text-transform:uppercase; color:var(--primary); margin-bottom:0.5rem;">Categorieën</p>
                <h2 style="font-family:'Fraunces',serif; font-size:clamp(1.6rem,3vw,2.2rem); font-weight:700; color:var(--dark); font-optical-sizing:auto;">Bekijk per categorie</h2>
            </div>
            <div class="sub-grid" style="display:grid; grid-template-columns:repeat(3,1fr); gap:1.25rem;">
                {subcategories.map((sub, i) => (
                    <a href={sub.href} class="sub-card" style={`display:flex; flex-direction:column; background:var(--cream); border:1.5px solid var(--border); border-top:3px solid ${i % 3 === 0 ? 'var(--primary)' : i % 3 === 1 ? 'var(--orange)' : 'var(--yellow)'}; border-radius:14px; padding:1.75rem; text-decoration:none;`}>
                        <h3 style="font-family:'Fraunces',serif; font-size:1.1rem; font-weight:700; color:var(--dark); margin-bottom:0.5rem; font-optical-sizing:auto;">{sub.title}</h3>
                        <p style="font-family:'Nunito',sans-serif; font-size:0.875rem; color:var(--muted); line-height:1.65; margin:0 0 1.25rem; flex:1;">{sub.description}</p>
                        <span style="font-family:'Nunito',sans-serif; font-size:0.82rem; font-weight:700; color:var(--primary);">Lees meer →</span>
                    </a>
                ))}
            </div>
        </div>
    </section>
)}

<!-- BLOG POSTS -->
{posts.length > 0 && (
    <section id="blogs" style="background:var(--cream); padding:4.5rem 1.5rem 5rem;">
        <div style="max-width:1160px; margin:0 auto;">
            <div style="display:flex; align-items:flex-end; justify-content:space-between; margin-bottom:2rem; flex-wrap:wrap; gap:1rem;">
                <div>
                    <p style="font-family:'Nunito',sans-serif; font-size:0.68rem; font-weight:700; letter-spacing:0.18em; text-transform:uppercase; color:var(--primary); margin-bottom:0.5rem;">Blogs</p>
                    <h2 style="font-family:'Fraunces',serif; font-size:clamp(1.6rem,3vw,2.2rem); font-weight:700; color:var(--dark); font-optical-sizing:auto;">Alle blogs over {title.toLowerCase()}</h2>
                </div>
                <a href="/blog" style="font-family:'Nunito',sans-serif; font-size:0.85rem; font-weight:700; color:var(--primary);">Alle blogs →</a>
            </div>
            <div class="posts-grid" style="display:grid; grid-template-columns:repeat(3,1fr); gap:1.5rem;">
                {posts.map((post: any, i: number) => (
                    <a href={`/blog/${post.slug?.current}`} class="post-card" style={`display:block; background:var(--white); border:1.5px solid var(--border); border-top:3px solid ${i % 3 === 0 ? 'var(--primary)' : i % 3 === 1 ? 'var(--orange)' : 'var(--yellow)'}; border-radius:14px; overflow:hidden; text-decoration:none; box-shadow:0 2px 8px rgba(13,40,48,0.05);`}>
                        <div style={`height:200px; background:var(--primary-light); ${post.imageUrl ? `background-image:url('${post.imageUrl}'); background-size:cover; background-position:center;` : ''}`}></div>
                        <div style="padding:1.25rem 1.5rem 1.6rem;">
                            <p style="font-family:'Nunito',sans-serif; font-size:0.72rem; color:var(--muted-light); margin-bottom:0.4rem;">{formatDate(post.publishedAt)}</p>
                            <h3 style="font-family:'Fraunces',serif; font-size:1.05rem; font-weight:700; color:var(--dark); line-height:1.3; margin-bottom:0.5rem; font-optical-sizing:auto;">{post.title}</h3>
                            <p style="font-family:'Nunito',sans-serif; font-size:0.875rem; color:var(--muted); line-height:1.65; margin:0;">{excerpt(post.body)}</p>
                        </div>
                    </a>
                ))}
            </div>
        </div>
    </section>
)}

<!-- EMPTY STATE -->
{posts.length === 0 && !pillarContent && (
    <section style="background:var(--cream); padding:6rem 1.5rem; text-align:center;">
        <p style="font-family:'Fraunces',serif; font-size:1.5rem; color:var(--dark); margin-bottom:0.75rem; font-optical-sizing:auto;">Binnenkort hier te lezen</p>
        <p style="font-family:'Nunito',sans-serif; font-size:0.95rem; color:var(--muted); margin-bottom:2rem;">We werken aan nieuwe blogs voor deze categorie.</p>
        <a href="/blog" style="font-family:'Nunito',sans-serif; font-weight:700; font-size:0.9rem; background:var(--orange); color:var(--dark); padding:0.75rem 1.5rem; border-radius:30px; text-decoration:none;">Bekijk alle blogs →</a>
    </section>
)}

<script>
    const toc = document.getElementById('pillar-toc');
    if (toc) {
        const headings = document.querySelectorAll('.pillar-body h2');
        headings.forEach((h, i) => {
            const id = `section-${i}`;
            h.id = id;
            const a = document.createElement('a');
            a.href = `#${id}`;
            a.textContent = h.textContent || '';
            a.style.cssText = "font-family:'Nunito',sans-serif; font-size:0.82rem; font-weight:600; color:var(--muted); text-decoration:none; padding:0.35rem 0.5rem; border-radius:6px; display:block; transition:color 0.15s, background 0.15s; line-height:1.4;";
            a.onmouseover = () => { a.style.color = 'var(--dark)'; a.style.background = 'var(--border)'; };
            a.onmouseout  = () => { a.style.color = 'var(--muted)'; a.style.background = ''; };
            toc.appendChild(a);
        });
        if (headings.length === 0) {
            const aside = toc.closest('aside');
            if (aside) (aside as HTMLElement).style.display = 'none';
        }
    }
</script>

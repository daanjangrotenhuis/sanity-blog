---
interface Props {
    title: string;
    label: string;
    intro: string;
    pillarContent?: any[];
    subcategories?: { slug: string; title: string; description: string; href: string }[];
    posts: any[];
    breadcrumb?: { label: string; href: string };
    groupSlug?: string;
}

const { title, label, intro, pillarContent, subcategories, posts, breadcrumb, groupSlug } = Astro.props;

function formatDate(dateStr: string) {
    if (!dateStr) return '';
    return new Date(dateStr).toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' });
}

function excerpt(body: string, length = 110) {
    if (!body) return '';
    const plain = body.replace(/<[^>]+>/g, '');
    return plain.length > length ? plain.slice(0, length).trimEnd() + '…' : plain;
}

function renderPT(blocks: any[]): string {
    if (!Array.isArray(blocks) || blocks.length === 0) return '';
    return blocks.map(block => {
        if (block._type !== 'block') return '';
        const text = (block.children || []).map((child: any) => {
            let t = (child.text || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
            if (child.marks?.includes('strong')) t = `<strong>${t}</strong>`;
            if (child.marks?.includes('em')) t = `<em>${t}</em>`;
            // handle link marks
            const linkMark = (child.marks || []).find((m: string) => typeof m === 'string' && m.length > 10);
            if (linkMark && block.markDefs) {
                const def = block.markDefs.find((d: any) => d._key === linkMark);
                if (def?.href) t = `<a href="${def.href}">${t}</a>`;
            }
            return t;
        }).join('');
        switch (block.style) {
            case 'h2': return `<h2>${text}</h2>`;
            case 'h3': return `<h3>${text}</h3>`;
            case 'h4': return `<h4>${text}</h4>`;
            case 'blockquote': return `<blockquote>${text}</blockquote>`;
            default: return text ? `<p>${text}</p>` : '';
        }
    }).join('\n');
}

const pillarHtml = pillarContent ? renderPT(pillarContent) : '';
---

<style>
    .pillar-body h2 {
        font-family: 'Fraunces', serif;
        font-size: 1.55rem;
        font-weight: 700;
        color: var(--dark);
        margin: 2.5rem 0 0.9rem;
        line-height: 1.25;
        font-optical-sizing: auto;
    }
    .pillar-body h3 {
        font-family: 'Fraunces', serif;
        font-size: 1.2rem;
        font-weight: 700;
        color: var(--dark);
        margin: 2rem 0 0.65rem;
        font-optical-sizing: auto;
    }
    .pillar-body h4 {
        font-family: 'Nunito', sans-serif;
        font-size: 1rem;
        font-weight: 700;
        color: var(--dark);
        margin: 1.5rem 0 0.5rem;
    }
    .pillar-body p {
        font-family: 'Nunito', sans-serif;
        font-size: 1rem;
        color: var(--muted);
        line-height: 1.85;
        margin: 0 0 1.1rem;
    }
    .pillar-body strong { color: var(--dark); }
    .pillar-body blockquote {
        border-left: 3px solid var(--primary);
        margin: 1.5rem 0;
        padding: 0.75rem 1.25rem;
        background: var(--primary-light);
        border-radius: 0 8px 8px 0;
        font-family: 'Nunito', sans-serif;
        font-size: 1rem;
        color: var(--dark);
        line-height: 1.7;
    }
    .pillar-body a {
        color: var(--primary-dark);
        text-decoration: underline;
        text-underline-offset: 3px;
    }
    .pillar-body a:hover { color: var(--primary); }

    .cat-card { transition: transform 0.22s ease, box-shadow 0.22s ease; }
    .cat-card:hover { transform: translateY(-5px); box-shadow: 0 16px 40px rgba(13,40,48,0.12) !important; }

    .post-card { transition: transform 0.22s ease, box-shadow 0.22s ease; }
    .post-card:hover { transform: translateY(-5px); box-shadow: 0 16px 40px rgba(13,40,48,0.12) !important; }

    @media (max-width: 768px) {
        .posts-grid { grid-template-columns: 1fr !important; }
        .sub-grid { grid-template-columns: 1fr !important; }
    }
    @media (min-width: 769px) and (max-width: 1024px) {
        .posts-grid { grid-template-columns: repeat(2, 1fr) !important; }
        .sub-grid { grid-template-columns: repeat(2, 1fr) !important; }
    }
</style>

<section style="background: var(--dark); padding: 3.5rem 2rem 3rem;">
    <div style="max-width: 1160px; margin: 0 auto;">
        {breadcrumb && (
            <p style="font-family: 'Nunito', sans-serif; font-size: 0.78rem; color: rgba(255,255,255,0.35); margin-bottom: 0.75rem;">
                <a href={breadcrumb.href} style="color: rgba(255,255,255,0.35); text-decoration: none;">{breadcrumb.label}</a>
                {' / '}
                <span style="color: rgba(255,255,255,0.55);">{title}</span>
            </p>
        )}
        <p style="font-family: 'Nunito', sans-serif; font-size: 0.68rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--yellow); margin-bottom: 0.75rem;">{label}</p>
        <h1 style="font-family: 'Fraunces', serif; font-size: clamp(2rem, 4vw, 2.8rem); font-weight: 700; color: white; margin-bottom: 1rem; font-optical-sizing: auto;">{title}</h1>
        <p style="font-family: 'Nunito', sans-serif; font-size: 1rem; color: rgba(255,255,255,0.5); max-width: 640px; line-height: 1.75; margin: 0;">{intro}</p>
    </div>
</section>

<main style="max-width: 1160px; margin: 0 auto; padding: 3.5rem 1.5rem 5rem;">

    {pillarHtml && (
        <article class="pillar-body" style="max-width: 780px; margin: 0 auto 4rem;" set:html={pillarHtml} />
    )}

    {subcategories && subcategories.length > 0 && (
        <div style="margin-bottom: 4rem;">
            <p style="font-family: 'Nunito', sans-serif; font-size: 0.68rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--primary); margin-bottom: 1.5rem;">Bekijk per categorie</p>
            <div class="sub-grid" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem;">
                {subcategories.map((sub, i) => (
                    <a href={sub.href} class="cat-card" style={`display: block; background: var(--white); border: 1.5px solid var(--border); border-top: 3px solid ${i % 3 === 0 ? 'var(--primary)' : i % 3 === 1 ? 'var(--orange)' : 'var(--yellow)'}; border-radius: 12px; padding: 1.5rem; text-decoration: none;`}>
                        <h2 style="font-family: 'Fraunces', serif; font-size: 1.1rem; font-weight: 700; color: var(--dark); margin-bottom: 0.5rem; font-optical-sizing: auto;">{sub.title}</h2>
                        <p style="font-family: 'Nunito', sans-serif; font-size: 0.85rem; color: var(--muted); line-height: 1.6; margin: 0 0 1rem;">{sub.description}</p>
                        <span style="font-family: 'Nunito', sans-serif; font-size: 0.82rem; font-weight: 700; color: var(--primary);">Lees meer →</span>
                    </a>
                ))}
            </div>
        </div>
    )}

    {posts.length > 0 && (
        <div>
            <p style="font-family: 'Nunito', sans-serif; font-size: 0.68rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--primary); margin-bottom: 1.5rem;">Gerelateerde blogs</p>
            <div class="posts-grid" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem;">
                {posts.map((post: any, i: number) => (
                    <a href={`/blog/${post.slug?.current}`} class="post-card" style={`display: block; background: var(--white); border: 1.5px solid var(--border); border-top: 3px solid ${i % 3 === 0 ? 'var(--primary)' : i % 3 === 1 ? 'var(--orange)' : 'var(--yellow)'}; border-radius: 12px; overflow: hidden; text-decoration: none; box-shadow: 0 2px 8px rgba(13,40,48,0.05);`}>
                        <div style={`height: 190px; background: var(--primary-light); ${post.imageUrl ? `background-image: url('${post.imageUrl}'); background-size: cover; background-position: center;` : ''}`}></div>
                        <div style="padding: 1.2rem 1.4rem 1.5rem;">
                            <p style="font-family: 'Nunito', sans-serif; font-size: 0.72rem; color: var(--muted-light); margin-bottom: 0.45rem;">{formatDate(post.publishedAt)}</p>
                            <h2 style="font-family: 'Fraunces', serif; font-size: 1.05rem; font-weight: 700; color: var(--dark); line-height: 1.3; margin-bottom: 0.5rem; font-optical-sizing: auto;">{post.title}</h2>
                            <p style="font-family: 'Nunito', sans-serif; font-size: 0.85rem; color: var(--muted); line-height: 1.65; margin: 0;">{excerpt(post.body)}</p>
                        </div>
                    </a>
                ))}
            </div>
        </div>
    )}

    {posts.length === 0 && !pillarHtml && (
        <div style="text-align: center; padding: 5rem 0;">
            <p style="font-family: 'Fraunces', serif; font-size: 1.5rem; color: var(--dark); margin-bottom: 0.75rem; font-optical-sizing: auto;">Binnenkort hier te lezen</p>
            <p style="font-family: 'Nunito', sans-serif; font-size: 0.95rem; color: var(--muted); margin-bottom: 2rem;">We werken aan nieuwe blogs voor deze categorie.</p>
            <a href="/blog" style="font-family: 'Nunito', sans-serif; font-weight: 700; font-size: 0.9rem; background: var(--orange); color: var(--dark); padding: 0.75rem 1.5rem; border-radius: 30px; text-decoration: none;">Bekijk alle blogs →</a>
        </div>
    )}
</main>

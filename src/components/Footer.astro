---
const today = new Date();
---

<footer style="border-top: 1px solid var(--border); margin-top: 6rem; padding: 3rem 1.5rem;">
    <div style="max-width: 1100px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1.5rem;">

        <div>
            <div style="font-family: 'Playfair Display', serif; font-size: 1rem; font-weight: 700; color: var(--dark); margin-bottom: 0.25rem;">
                Vakantie voor Kids
            </div>
            <p style="font-size: 0.85rem; color: var(--muted); margin: 0;">
                Reistips en inspiratie voor gezinnen.
            </p>
        </div>

        <nav style="display: flex; gap: 2rem;">
            {[['/', 'Home'], ['/blog', 'Artikelen'], ['/about', 'Over ons']].map(([href, label]) => (
                <a href={href} style="font-size: 0.875rem; color: var(--muted);" onmouseover="this.style.color='var(--dark)'" onmouseout="this.style.color='var(--muted)'">{label}</a>
            ))}
        </nav>

        <p style="font-size: 0.8rem; color: var(--muted); margin: 0;">
            &copy; {today.getFullYear()} vakantievoorkids.nl
        </p>

    </div>
</footer>

{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/about/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin(?:/(.*?))?/?$",
			"dest": "_render"
		},
		{
			"src": "^/bestemmingen/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/bestemmingen/?$",
			"dest": "_render"
		},
		{
			"src": "^/blog/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/blog/?$",
			"dest": "_render"
		},
		{
			"src": "^/overnachten/ontdekken/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/overnachten/ontdekken/?$",
			"dest": "_render"
		},
		{
			"src": "^/overnachten/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/overnachten/?$",
			"dest": "_render"
		},
		{
			"src": "^/rss\\.xml$",
			"dest": "_render"
		},
		{
			"src": "^/sitemap\\.xml$",
			"dest": "_render"
		},
		{
			"src": "^/uitjes/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/uitjes/?$",
			"dest": "_render"
		},
		{
			"src": "^/vakantie-met-kids/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render",
			"status": 404
		}
	]
}
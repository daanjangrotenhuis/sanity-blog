---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="nl">
<head>
    <BaseHead title={`Over ons — ${SITE_TITLE}`} description="Vakantie voor Kids is een platform vol reisinspiratie voor ouders. Ontdek vakantieparken, campings, dagtrips en bestemmingen die echt leuk zijn voor kinderen." />
</head>
<style>
    @media (max-width: 768px) {
        .grid-2 { grid-template-columns: 1fr !important; gap: 2rem !important; }
        .cta-block { padding: 2rem 1.5rem !important; flex-direction: column !important; align-items: flex-start !important; }
    }
</style>
<body style="background: var(--cream);">

    <Header />

    <section style="background: var(--dark); min-height: 42vh; display: flex; flex-direction: column; justify-content: center; position: relative; overflow: hidden;">
        <div style="position: absolute; top: -80px; right: -80px; width: 420px; height: 420px; border: 1px solid rgba(255,255,255,0.05); border-radius: 50%; pointer-events: none;"></div>
        <div style="position: absolute; bottom: -60px; left: 5%; width: 280px; height: 280px; border: 1px solid rgba(255,255,255,0.04); border-radius: 50%; pointer-events: none;"></div>
        <div style="position: relative; z-index: 2; padding: 3.5rem 2.5rem 4.5rem; max-width: 760px;">
            <p style="font-family: 'Nunito', sans-serif; font-size: 0.68rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--yellow); margin-bottom: 1.25rem;">Over ons</p>
            <h1 style="font-family: 'Fraunces', serif; font-size: clamp(2.2rem, 5vw, 3.8rem); font-weight: 700; line-height: 1.1; color: white; font-optical-sizing: auto; margin-bottom: 1.25rem;">
                Vakantie plannen<br/>
                <em style="font-weight: 300; font-style: italic; color: var(--yellow);">zonder gedoe</em>
            </h1>
            <p style="font-family: 'Nunito', sans-serif; font-size: 1rem; color: rgba(255,255,255,0.55); max-width: 500px; line-height: 1.75; margin: 0;">
                Vakantie voor Kids is een platform met reisinspiratie voor gezinnen. Praktische informatie over bestemmingen die kinderen écht leuk vinden.
            </p>
        </div>
    </section>

    <section style="max-width: 820px; margin: 0 auto; padding: 5rem 1.5rem 0;">
        <div class="grid-2" style="display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: start;">
            <div>
                <h2 style="font-family: 'Fraunces', serif; font-size: 1.8rem; font-weight: 700; color: var(--dark); line-height: 1.25; margin-bottom: 1.25rem; font-optical-sizing: auto;">
                    Wat is Vakantie voor Kids?
                </h2>
                <p style="font-family: 'Nunito', sans-serif; font-size: 1rem; color: var(--muted); line-height: 1.85; margin-bottom: 1rem;">
                    Een plek waar ouders terecht kunnen voor praktische informatie over vakanties met kinderen. We schrijven over vakantieparken, campings, strandbestemmingen, dagtrips, reviews en reizen naar het buitenland.
                </p>
                <p style="font-family: 'Nunito', sans-serif; font-size: 1rem; color: var(--muted); line-height: 1.85; margin: 0;">
                    Onze blogs zijn gericht op gezinnen met kinderen, van een dagje erop uit tot een vakantie van twee weken in het buitenland.
                </p>
            </div>
            <div>
                <h2 style="font-family: 'Fraunces', serif; font-size: 1.8rem; font-weight: 700; color: var(--dark); line-height: 1.25; margin-bottom: 1.25rem; font-optical-sizing: auto;">
                    Waarom dit platform?
                </h2>
                <p style="font-family: 'Nunito', sans-serif; font-size: 1rem; color: var(--muted); line-height: 1.85; margin-bottom: 1rem;">
                    Als ouder wil je gewoon weten: is dit vakantiepark leuk voor kinderen van 4 jaar? Is het strand veilig? Is er genoeg te doen als het regent?
                </p>
                <p style="font-family: 'Nunito', sans-serif; font-size: 1rem; color: var(--muted); line-height: 1.85; margin: 0;">
                    Daar geven wij antwoord op. Zonder eindeloos scrollen door recensies van mensen zonder kinderen.
                </p>
            </div>
        </div>
    </section>

    <section style="max-width: 820px; margin: 0 auto; padding: 5rem 1.5rem 0;">
        <p style="font-family: 'Nunito', sans-serif; font-size: 0.68rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--primary); margin-bottom: 0.75rem;">Wat je hier vindt</p>
        <h2 style="font-family: 'Fraunces', serif; font-size: 1.8rem; font-weight: 700; color: var(--dark); margin-bottom: 2rem; font-optical-sizing: auto;">Onderwerpen die we behandelen</h2>
        <div class="grid-2" style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
            {[
                { title: 'Vakantieparken', body: 'Welke parken zijn echt leuk voor kinderen? We schrijven over de faciliteiten, de sfeer en of het de prijs waard is.' },
                { title: 'Strand & Zee', body: 'Van de Zeeuwse kust tot het Gardameer. Welke stranden zijn veilig en kindvriendelijk?' },
                { title: 'Camping', body: 'Kamperen met kinderen is een belevenis. We tippen de mooiste campings in Nederland en Europa.' },
                { title: 'Buitenland', body: 'Duitsland, Oostenrijk, Italië of Spanje — met kinderen op pad in Europa en verder.' },
                { title: 'Dagtrips', body: 'Een dagje erop uit hoeft niet ver te zijn. De leukste uitjes voor gezinnen dichtbij huis.' },
                { title: 'Reistips', body: 'Praktische tips over inpakken, rijden met kinderen, goedkoop reizen en alles wat er bij komt kijken.' },
            ].map(item => (
                <div style="background: var(--white); border: 1.5px solid var(--border); border-top: 3px solid var(--primary); border-radius: 12px; padding: 1.75rem;">
                    <h3 style="font-family: 'Fraunces', serif; font-size: 1.1rem; font-weight: 700; color: var(--dark); margin-bottom: 0.6rem; font-optical-sizing: auto;">{item.title}</h3>
                    <p style="font-family: 'Nunito', sans-serif; font-size: 0.9rem; color: var(--muted); line-height: 1.7; margin: 0;">{item.body}</p>
                </div>
            ))}
        </div>
    </section>

    <section style="max-width: 820px; margin: 0 auto; padding: 5rem 1.5rem 6rem;">
        <div class="cta-block" style="background: var(--dark); border-radius: 20px; padding: 3.5rem; display: flex; align-items: center; justify-content: space-between; gap: 2rem; flex-wrap: wrap;">
            <div>
                <h2 style="font-family: 'Fraunces', serif; font-size: 1.6rem; font-weight: 700; color: white; margin-bottom: 0.6rem; font-optical-sizing: auto;">
                    Klaar voor inspiratie?
                </h2>
                <p style="font-family: 'Nunito', sans-serif; font-size: 0.95rem; color: rgba(255,255,255,0.55); margin: 0; max-width: 360px; line-height: 1.65;">
                    Bekijk alle blogs over vakanties, vakantieparken, campings en dagtrips met kinderen.
                </p>
            </div>
            <a href="/blog" style="font-family: 'Nunito', sans-serif; font-weight: 700; font-size: 0.9rem; background: var(--orange); color: var(--dark); padding: 0.85rem 1.75rem; border-radius: 30px; white-space: nowrap; transition: background 0.15s; text-decoration: none;" onmouseover="this.style.background='var(--orange-dark)'" onmouseout="this.style.background='var(--orange)'">
                Alle blogs lezen →
            </a>
        </div>
    </section>

    <Footer />
</body>
</html>

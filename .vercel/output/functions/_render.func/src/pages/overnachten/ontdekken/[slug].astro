---
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { SITE_TITLE } from '../../../consts';
import { sanityClient } from 'sanity:client';

const { slug } = Astro.params;

const [park, relatedPosts] = await Promise.all([
    sanityClient.fetch(`
        *[_type == "park" && slug.current == $slug][0]{
            name, slug, type, tagline, description, heroImageUrl, imageUrls,
            videoUrl, facilities, omgeving, location, openingPeriod, priceFrom,
            website, bookingUrl, discount, featured
        }
    `, { slug }),
    sanityClient.fetch(`
        *[_type == "post" && $slug in categories] | order(publishedAt desc)[0...6]{
            title, slug, publishedAt, body, imageUrl
        }
    `, { slug }),
]);

if (!park) {
    return Astro.redirect('/overnachten/ontdekken');
}

const FACILITY_LABELS: Record<string, string> = {
    'zwembad': '🏊 Zwembad',
    'subtropisch-zwembad': '🌴 Subtropisch zwembad',
    'speeltuin': '🎡 Speeltuin',
    'hondenvriendelijk': '🐕 Honden welkom',
    'nabij-attractiepark': '🎢 Nabij attractiepark',
    'restaurant': '🍴 Restaurant',
    'animatie': '🎯 Animatie',
    'kinderanimatie': '🎭 Kinderanimatie',
    'wifi': '📶 Wifi',
    'sport-spel': '⚽ Sport & spel',
    'sauna-wellness': '🧖 Sauna & wellness',
    'fietsverhuur': '🚲 Fietsverhuur',
    'strand-meer': '🏖️ Strand/meer nabij',
    'klimpark': '🌲 Klimpark',
    'supermarkt': '🛒 Supermarkt nabij',
    'rolstoeltoegankelijk': '♿ Rolstoeltoegankelijk',
};

const OMGEVING_LABELS: Record<string, string> = {
    'bos':               '🌲 Bos',
    'strand':            '🏖️ Strand',
    'zee':               '🌊 Zee',
    'meer':              '💧 Meer / rivier',
    'bergen':            '🏔️ Bergen / heuvelland',
    'natuur':            '🌿 Natuur / heide',
    'duinen':            '🏜️ Duinen',
    'nabij-attractiepark':'🎢 Nabij attractiepark',
    'stad':              '🏙️ Stad nabij',
    'ns-station':        '🚂 NS-station nabij',
    'snelweg':           '🛣️ Snelweg nabij',
};

const TYPE_LABELS: Record<string, string> = {
    'vakantiepark': 'Vakantiepark',
    'camping': 'Camping',
    'glamping': 'Glamping',
    'hotel': 'Hotel',
    'bungalowpark': 'Bungalowpark',
    'boerderijcamping': 'Boerderijcamping',
};

function youtubeEmbed(url: string): string | null {
    const match = url?.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/)([^&\s]+)/);
    return match ? `https://www.youtube.com/embed/${match[1]}` : null;
}

function formatDate(dateStr: string) {
    if (!dateStr) return '';
    return new Date(dateStr).toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' });
}

function excerpt(body: string, length = 115) {
    if (!body) return '';
    const plain = body.replace(/<[^>]+>/g, '');
    return plain.length > length ? plain.slice(0, length).trimEnd() + '…' : plain;
}

const embedUrl = park.videoUrl ? youtubeEmbed(park.videoUrl) : null;
const allImages = [park.heroImageUrl, ...(park.imageUrls ?? [])].filter(Boolean);
const metaDescription = park.tagline ?? `Alles over ${park.name} — faciliteiten, foto's, locatie en meer.`;
---

<!doctype html>
<html lang="nl">
<head>
    <BaseHead title={`${park.name} — ${SITE_TITLE}`} description={metaDescription} />
</head>
<body style="background: var(--cream);">
    <Header />

    <!-- HERO -->
    <div style={`position:relative; min-height:480px; display:flex; flex-direction:column; justify-content:flex-end; overflow:hidden; background:var(--dark);`}>
        {park.heroImageUrl && (
            <div style={`position:absolute; inset:0; background-image:url('${park.heroImageUrl}'); background-size:cover; background-position:center;`}></div>
        )}
        <div style="position:absolute; inset:0; background:linear-gradient(170deg, rgba(13,40,48,0.35) 0%, rgba(13,40,48,0.8) 100%);"></div>
        <div style="position:relative; z-index:2; max-width:1160px; margin:0 auto; padding:2rem 2rem 4rem; width:100%;">
            <p style="font-family:'Nunito',sans-serif; font-size:0.72rem; color:rgba(255,255,255,0.4); margin-bottom:0.6rem;">
                <a href="/overnachten" style="color:rgba(255,255,255,0.4); text-decoration:none;">Overnachten</a>
                {' / '}
                <a href="/overnachten/ontdekken" style="color:rgba(255,255,255,0.4); text-decoration:none;">Ontdekken</a>
                {' / '}
                <span style="color:rgba(255,255,255,0.6);">{park.name}</span>
            </p>
            {park.type && (
                <span style="font-family:'Nunito',sans-serif; font-size:0.68rem; font-weight:700; letter-spacing:0.14em; text-transform:uppercase; background:var(--primary); color:white; padding:0.3rem 0.8rem; border-radius:20px; display:inline-block; margin-bottom:0.85rem;">
                    {TYPE_LABELS[park.type] ?? park.type}
                </span>
            )}
            {park.featured && (
                <span style="font-family:'Nunito',sans-serif; font-size:0.68rem; font-weight:700; letter-spacing:0.14em; text-transform:uppercase; background:var(--orange); color:var(--dark); padding:0.3rem 0.8rem; border-radius:20px; display:inline-block; margin-bottom:0.85rem; margin-left:0.5rem;">
                    ⭐ Uitgelicht
                </span>
            )}
            <h1 style="font-family:'Fraunces',serif; font-size:clamp(2rem,5vw,3.2rem); font-weight:700; color:white; line-height:1.1; margin-bottom:0.75rem; font-optical-sizing:auto;">{park.name}</h1>
            {park.tagline && (
                <p style="font-family:'Nunito',sans-serif; font-size:1.05rem; color:rgba(255,255,255,0.7); max-width:560px; line-height:1.7; margin:0;">{park.tagline}</p>
            )}
            {park.location?.city && (
                <p style="font-family:'Nunito',sans-serif; font-size:0.875rem; color:rgba(255,255,255,0.5); margin-top:0.75rem;">
                    📍 {park.location.city}{park.location.province ? `, ${park.location.province}` : ''}{park.location.country && park.location.country !== 'Nederland' ? ` · ${park.location.country}` : ''}
                </p>
            )}
        </div>
        <div style="position:absolute; bottom:-2px; left:0; right:0; z-index:3; line-height:0;">
            <svg viewBox="0 0 1440 60" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none" style="display:block; width:100%; height:60px;">
                <path d="M0,0 C360,55 720,5 1080,45 C1260,60 1380,15 1440,0 L1440,60 L0,60 Z" fill="#ffffff"/>
            </svg>
        </div>
    </div>

    <!-- GALLERY STRIP -->
    {allImages.length > 1 && (
        <div style="background:white; border-bottom:1px solid var(--border);">
            <div style="max-width:1160px; margin:0 auto; padding:1.5rem 1.5rem;">
                <div style="display:flex; gap:0.75rem; overflow-x:auto; padding-bottom:0.5rem; scrollbar-width:thin;">
                    {allImages.map((url: string, i: number) => (
                        <div
                            style={`flex-shrink:0; width:${i === 0 ? '380px' : '240px'}; height:200px; border-radius:12px; overflow:hidden; cursor:pointer; background:var(--primary-light);`}
                            onclick={`document.getElementById('lightbox').style.display='flex'; document.getElementById('lightbox-img').src='${url}';`}
                        >
                            <img src={url} alt={`${park.name} foto ${i + 1}`} style="width:100%; height:100%; object-fit:cover; display:block;" loading="lazy" />
                        </div>
                    ))}
                </div>
            </div>
        </div>
    )}

    <!-- LIGHTBOX -->
    <div id="lightbox" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.92); z-index:1000; align-items:center; justify-content:center;" onclick="this.style.display='none'">
        <img id="lightbox-img" src="" alt="" style="max-width:90vw; max-height:90vh; object-fit:contain; border-radius:8px;" />
    </div>

    <!-- MAIN CONTENT -->
    <div style="background:white; border-bottom:1px solid var(--border);">
        <div style="max-width:1160px; margin:0 auto; padding:4rem 1.5rem 5rem; display:grid; grid-template-columns:1fr 320px; gap:4rem; align-items:start;" class="park-content-grid">

            <!-- Left: description + video -->
            <div>
                {park.description ? (
                    <article set:html={park.description} class="park-body" />
                ) : (
                    <p style="font-family:'Nunito',sans-serif; font-size:1rem; color:var(--muted); font-style:italic;">Beschrijving volgt binnenkort.</p>
                )}

                {embedUrl && (
                    <div style="margin-top:3rem;">
                        <h2 style="font-family:'Fraunces',serif; font-size:1.5rem; font-weight:700; color:var(--dark); margin-bottom:1.25rem; font-optical-sizing:auto;">Video</h2>
                        <div style="position:relative; padding-bottom:56.25%; height:0; border-radius:14px; overflow:hidden; background:var(--dark);">
                            <iframe
                                src={embedUrl}
                                title={`Video van ${park.name}`}
                                style="position:absolute; inset:0; width:100%; height:100%; border:0;"
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                allowfullscreen
                            ></iframe>
                        </div>
                    </div>
                )}
            </div>

            <!-- Right: info sidebar -->
            <aside style="position:sticky; top:2rem; display:flex; flex-direction:column; gap:1.25rem;">

                <!-- Discount highlight -->
                {park.discount && (
                    <div style="background:var(--orange); border-radius:14px; padding:1.25rem 1.4rem;">
                        <p style="font-family:'Nunito',sans-serif; font-size:0.68rem; font-weight:700; letter-spacing:0.14em; text-transform:uppercase; color:rgba(13,40,48,0.6); margin-bottom:0.4rem;">🎁 Speciale aanbieding</p>
                        <p style="font-family:'Nunito',sans-serif; font-size:0.9rem; font-weight:700; color:var(--dark); line-height:1.5; margin:0;">{park.discount}</p>
                    </div>
                )}

                <!-- Info card -->
                <div style="background:var(--cream); border:1.5px solid var(--border); border-radius:14px; padding:1.5rem;">

                    {park.priceFrom && (
                        <div style="margin-bottom:1.25rem; padding-bottom:1.25rem; border-bottom:1px solid var(--border);">
                            <p style="font-family:'Nunito',sans-serif; font-size:0.72rem; font-weight:700; letter-spacing:0.12em; text-transform:uppercase; color:var(--muted-light); margin-bottom:0.3rem;">Prijs</p>
                            <p style="font-family:'Fraunces',serif; font-size:1.5rem; font-weight:700; color:var(--dark); font-optical-sizing:auto; margin:0;">
                                €{park.priceFrom} <span style="font-size:0.875rem; font-family:'Nunito',sans-serif; font-weight:400; color:var(--muted);">/ nacht</span>
                            </p>
                        </div>
                    )}

                    {park.openingPeriod && (
                        <div style="margin-bottom:1rem;">
                            <p style="font-family:'Nunito',sans-serif; font-size:0.72rem; font-weight:700; letter-spacing:0.12em; text-transform:uppercase; color:var(--muted-light); margin-bottom:0.3rem;">Open</p>
                            <p style="font-family:'Nunito',sans-serif; font-size:0.9rem; font-weight:600; color:var(--dark); margin:0;">🗓️ {park.openingPeriod}</p>
                        </div>
                    )}

                    {park.location?.address && (
                        <div style="margin-bottom:1rem;">
                            <p style="font-family:'Nunito',sans-serif; font-size:0.72rem; font-weight:700; letter-spacing:0.12em; text-transform:uppercase; color:var(--muted-light); margin-bottom:0.3rem;">Adres</p>
                            <p style="font-family:'Nunito',sans-serif; font-size:0.875rem; color:var(--muted); margin:0;">{park.location.address}</p>
                        </div>
                    )}

                    {park.bookingUrl && (
                        <a href={park.bookingUrl} target="_blank" rel="noopener" style="display:block; font-family:'Nunito',sans-serif; font-size:0.9rem; font-weight:700; background:var(--primary); color:white; padding:0.8rem 1rem; border-radius:10px; text-decoration:none; text-align:center; margin-bottom:0.6rem;">
                            Boek nu →
                        </a>
                    )}
                    {park.website && (
                        <a href={park.website} target="_blank" rel="noopener" style="display:block; font-family:'Nunito',sans-serif; font-size:0.875rem; font-weight:600; background:white; color:var(--dark); border:1.5px solid var(--border); padding:0.7rem 1rem; border-radius:10px; text-decoration:none; text-align:center;">
                            Bezoek website
                        </a>
                    )}
                </div>

                <!-- Facilities -->
                {park.facilities?.length > 0 && (
                    <div style="background:var(--primary-light); border:1.5px solid #A8E8E2; border-radius:14px; padding:1.5rem;">
                        <p style="font-family:'Nunito',sans-serif; font-size:0.68rem; font-weight:700; letter-spacing:0.14em; text-transform:uppercase; color:var(--primary-dark); margin-bottom:1rem;">Faciliteiten</p>
                        <div style="display:flex; flex-direction:column; gap:0.4rem;">
                            {(park.facilities as string[]).map((f: string) => (
                                <span style="font-family:'Nunito',sans-serif; font-size:0.875rem; color:var(--primary-dark);">
                                    {FACILITY_LABELS[f] ?? f}
                                </span>
                            ))}
                        </div>
                    </div>
                )}

                <!-- Omgeving -->
                {park.omgeving?.length > 0 && (
                    <div style="background:var(--cream); border:1.5px solid var(--border); border-radius:14px; padding:1.5rem;">
                        <p style="font-family:'Nunito',sans-serif; font-size:0.68rem; font-weight:700; letter-spacing:0.14em; text-transform:uppercase; color:var(--muted-light); margin-bottom:1rem;">Omgeving</p>
                        <div style="display:flex; flex-direction:column; gap:0.4rem;">
                            {(park.omgeving as string[]).map((o: string) => (
                                <span style="font-family:'Nunito',sans-serif; font-size:0.875rem; color:var(--muted);">
                                    {OMGEVING_LABELS[o] ?? o}
                                </span>
                            ))}
                        </div>
                    </div>
                )}
            </aside>
        </div>
    </div>

    <!-- RELATED BLOGS -->
    {relatedPosts.length > 0 && (
        <section style="background:var(--cream); border-bottom:1px solid var(--border); padding:4.5rem 1.5rem 5rem;">
            <div style="max-width:1160px; margin:0 auto;">
                <div style="margin-bottom:2rem;">
                    <p style="font-family:'Nunito',sans-serif; font-size:0.68rem; font-weight:700; letter-spacing:0.18em; text-transform:uppercase; color:var(--primary); margin-bottom:0.5rem;">Blogs</p>
                    <h2 style="font-family:'Fraunces',serif; font-size:clamp(1.5rem,3vw,2rem); font-weight:700; color:var(--dark); font-optical-sizing:auto; margin:0;">Blogs over {park.name}</h2>
                </div>
                <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:1.5rem;" class="blog-grid">
                    {relatedPosts.map((post: any, i: number) => (
                        <a href={`/blog/${post.slug?.current}`} style={`display:block; background:white; border:1.5px solid var(--border); border-top:3px solid ${i % 3 === 0 ? 'var(--primary)' : i % 3 === 1 ? 'var(--orange)' : 'var(--yellow)'}; border-radius:14px; overflow:hidden; text-decoration:none; box-shadow:0 2px 8px rgba(13,40,48,0.05); transition:transform 0.22s ease, box-shadow 0.22s ease;`}
                            onmouseover="this.style.transform='translateY(-5px)'; this.style.boxShadow='0 16px 40px rgba(13,40,48,0.12)'"
                            onmouseout="this.style.transform=''; this.style.boxShadow='0 2px 8px rgba(13,40,48,0.05)'"
                        >
                            <div style={`height:180px; background:var(--primary-light); ${post.imageUrl ? `background-image:url('${post.imageUrl}'); background-size:cover; background-position:center;` : ''}`}></div>
                            <div style="padding:1.2rem 1.4rem 1.5rem;">
                                <p style="font-family:'Nunito',sans-serif; font-size:0.72rem; color:var(--muted-light); margin-bottom:0.35rem;">{formatDate(post.publishedAt)}</p>
                                <h3 style="font-family:'Fraunces',serif; font-size:1rem; font-weight:700; color:var(--dark); line-height:1.3; margin-bottom:0.4rem; font-optical-sizing:auto;">{post.title}</h3>
                                <p style="font-family:'Nunito',sans-serif; font-size:0.875rem; color:var(--muted); line-height:1.6; margin:0;">{excerpt(post.body)}</p>
                            </div>
                        </a>
                    ))}
                </div>
            </div>
        </section>
    )}

    <Footer />

    <style>
        :global(.park-body h2) {
            font-family: 'Fraunces', serif;
            font-size: clamp(1.4rem, 2.5vw, 1.8rem);
            font-weight: 700;
            color: var(--dark);
            margin: 2.5rem 0 0.75rem;
            line-height: 1.2;
            font-optical-sizing: auto;
            padding-bottom: 0.6rem;
            border-bottom: 2px solid var(--border);
        }
        :global(.park-body h2:first-child) { margin-top: 0; }
        :global(.park-body h3) {
            font-family: 'Fraunces', serif;
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--dark);
            margin: 2rem 0 0.5rem;
            padding-left: 0.9rem;
            border-left: 3px solid var(--primary);
            font-optical-sizing: auto;
        }
        :global(.park-body p) {
            font-family: 'Nunito', sans-serif;
            font-size: 1.025rem;
            color: var(--muted);
            line-height: 1.9;
            margin: 0 0 1.25rem;
        }
        :global(.park-body strong) { color: var(--dark); font-weight: 700; }
        :global(.park-body a) { color: var(--primary-dark); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }

        @media (max-width: 768px) {
            .park-content-grid { grid-template-columns: 1fr !important; }
            .blog-grid { grid-template-columns: 1fr !important; }
        }
        @media (min-width: 769px) and (max-width: 1024px) {
            .park-content-grid { grid-template-columns: 1fr 260px !important; gap: 2.5rem !important; }
            .blog-grid { grid-template-columns: repeat(2,1fr) !important; }
        }
    </style>
</body>
</html>
